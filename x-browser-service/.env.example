# 生成管理 Token：python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
X_LOGIN_SERVICE_TOKEN=replace-with-a-random-token-at-least-32-characters
X_LOGIN_PUBLIC_URL=https://xlogin.example.com
# 宿主机上的目录；必须映射到 AstrBot 的实际 data 目录中
ASTRBOT_COOKIE_DIR=/opt/astrbot/data/plugin_data/astrbot_plugin_link_preview
# 与读取 Cookie 的 AstrBot 运行用户 UID/GID 一致；默认 1000
LOGIN_UID=1000
LOGIN_GID=1000
# 如需要代理，填写从登录容器可访问的 HTTP 代理地址
X_BROWSER_PROXY=
