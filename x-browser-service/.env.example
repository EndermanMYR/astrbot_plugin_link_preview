# 抓取服务 Token，插件配置里的 x_browser_token 要和这里一致
# 生成：python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
X_LOGIN_SERVICE_TOKEN=replace-with-a-random-token-at-least-32-characters
# 宿主机上存放 Cookie 的目录；插件会把 x_cookie 写进这里
ASTRBOT_COOKIE_DIR=/opt/astrbot/data/plugin_data/astrbot_plugin_link_preview
# 容器运行用户，需与写入方一致（容器内 AstrBot 是 root 时填 0、0）
LOGIN_UID=1000
LOGIN_GID=1000
# 空闲多少秒关掉浏览器
X_SCRAPER_IDLE=300
